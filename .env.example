# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Strict Secret Isolation: ONLY generic placeholder values allowed here.
# Copy this file to '.env' and fill in your actual local configuration.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Local SQLite default (file:./dev.db) or PostgreSQL URI (postgresql://user:password@localhost:5432/drcp?schema=public)
DATABASE_URL="file:./dev.db"

# JWT Secret for RBAC Auth (Provide a cryptographically secure random string in production)
JWT_SECRET="your-jwt-secret-key-here"

# Caching Configuration (memory | redis)
CACHE_DRIVER=memory
REDIS_URL="redis://localhost:6379"

# Cache TTLs (in seconds)
REPORTS_CACHE_TTL=120
GEO_CACHE_TTL=86400

# External Service Limits
EXTERNAL_TIMEOUT_MS=3000

# Seed User Credentials for RBAC & Verification (Pass via environment, never hardcode in source)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="your-admin-secure-password"
SEED_ADMIN_API_KEY="your-admin-api-key"
SEED_CONTRIBUTOR_USERNAME="contributor"
SEED_CONTRIBUTOR_PASSWORD="your-contributor-secure-password"
SEED_CONTRIBUTOR_API_KEY="your-contributor-api-key"
SEED_VIEWER_USERNAME="viewer"
SEED_VIEWER_PASSWORD="your-viewer-secure-password"
SEED_VIEWER_API_KEY="your-viewer-api-key"
TEST_USER_PASSWORD="your-test-user-password"

