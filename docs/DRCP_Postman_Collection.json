              "raw": "{\n  \"title\": \"Monsoon Downpour in Mumbai\",\n  \"description\": \"Severe waterlogging across western railway tracks in Dadar, Mumbai.\",\n  \"location\": {\n    \"name\": \"Mumbai, Maharashtra\",\n    \"latitude\": 19.0760,\n    \"longitude\": 72.8777\n  },\n  \"tags\": [\"flood\", \"monsoon\"],\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/disasters",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "disasters"]
            },
            "description": "Creates a disaster incident with explicit user-supplied coordinates. Triggers Socket.io disaster_created event."
