    {
      "name": "3. Disaster Incident Management",
      "item": [
        {
          "name": "Create Disaster (NLP Auto-Geocoding from Description)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"NLP extracted Manhattan location\", function () {",
                  "    pm.expect(json.data.location.name).to.eql(\"Manhattan, NYC\");",
                  "    pm.expect(json.data.location.latitude).to.eql(40.7831);",
                  "    pm.expect(json.data.location.longitude).to.eql(-73.9712);",
                  "});",
                  "if (json.data && json.data.id) {",
                  "    pm.collectionVariables.set(\"disasterId\", json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-user-role",
                "value": "contributor",
                "description": "RBAC: ADMIN or CONTRIBUTOR permitted"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Flash Flooding in Lower Manhattan\",\n  \"description\": \"Heavy flooding has affected Manhattan, NYC with subway stations and major avenues submerged under rapid rising water.\",\n  \"tags\": [\"flood\", \"urgent\", \"evacuation\"],\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/disasters",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "disasters"]
            },
            "description": "Creates a disaster incident. Location is omitted from body; the system automatically extracts 'Manhattan, NYC' from the text and resolves coordinates. Triggers Socket.io disaster_created event. Saves ID to {{disasterId}}."
          },
          "response": []
        },
        {
          "name": "Create Disaster (Explicit Coordinates)",
          "event": [
