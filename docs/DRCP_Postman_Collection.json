          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Has X-Cache header\", function () {",
                  "    pm.response.to.have.header(\"X-Cache\");",
                  "});",
                  "var xCache = pm.response.headers.get(\"X-Cache\");",
                  "pm.test(\"X-Cache header is HIT, MISS, or DEGRADED\", function () {",
                  "    pm.expect([\"HIT\", \"MISS\", \"DEGRADED\"]).to.include(xCache);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/disasters/{{disasterId}}/reports",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "disasters", "{{disasterId}}", "reports"]
            },
            "description": "Retrieves normalized community reports for a disaster.\n- Call 1: Triggers Cache Miss (X-Cache: MISS header), queries external social provider, normalizes feed, and caches with TTL 120s.\n- Call 2: Returns instantly from Cache (X-Cache: HIT header)."
          },
