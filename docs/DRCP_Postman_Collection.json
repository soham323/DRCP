      "name": "1. System Health",
      "item": [
        {
          "name": "Health Check (GET /health)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Service status is ok\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"ok\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Verifies server runtime status, uptime, and service health."
          },
          "response": []
        }
      ]
